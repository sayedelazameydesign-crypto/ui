# Line endings: normalise to LF in the repository, regardless of the author's OS.
* text=auto eol=lf

# Explicit text types (diffable, reviewable)
*.md      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Binary artifacts tracked through Git LFS (see docs/data/artifacts.md).
# Add the extension here BEFORE committing the first file of that type.
*.bin       filter=lfs diff=lfs merge=lfs -text
*.onnx      filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt        filter=lfs diff=lfs merge=lfs -text
*.pth       filter=lfs diff=lfs merge=lfs -text
*.npy       filter=lfs diff=lfs merge=lfs -text
*.npz       filter=lfs diff=lfs merge=lfs -text
*.parquet   filter=lfs diff=lfs merge=lfs -text
*.arrow     filter=lfs diff=lfs merge=lfs -text
*.sqlite    filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text
*.ai        filter=lfs diff=lfs merge=lfs -text
*.fig       filter=lfs diff=lfs merge=lfs -text
*.zip       filter=lfs diff=lfs merge=lfs -text

# Generated outputs must never be diffed or merged textually.
.index/**           -diff -merge linguist-generated=true
artifacts.manifest.json -diff linguist-generated=true
docs/architecture/graph.json -diff linguist-generated=true
